# Получить на https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Юзернейм канала (@my_channel) или числовой id (-1001234567890)
TG_CHANNEL=@my_channel

# Имя файла сессии Telethon (создастся автоматически после setup)
TG_SESSION=tg_monitor

# Путь к базе SQLite
TG_DB=tg_monitor.db

# Часовой пояс для отчётов (смещение от UTC в часах). Москва = 3
TG_TZ_OFFSET=3
